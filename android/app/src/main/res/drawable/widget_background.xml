<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Material surface card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Tonal overlay for subtle Material You depth -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface_overlay" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Outer stroke -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="17dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_outline" />
        </shape>
    </item>

</layer-list>
